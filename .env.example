APP_NAME=MindWeave
ENV=dev
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=rag_learner
MYSQL_PASSWORD=mindweave_pass_change_me
MYSQL_DATABASE=mindweave
MYSQL_ROOT_PASSWORD=mindweave_root_change_me
SECRET_KEY=replace_with_a_random_secret
ALGORITHM=HS256
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=3
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_BACKUP=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=10
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_MAX_PAGES=50
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5
LOG_LEVEL=INFO
# 容器部署时 Compose 用服务名覆盖 MYSQL_HOST、REDIS_HOST、NEO4J_URI。
# 下列连接地址仍供宿主机直接运行后端使用。
# SECRET_KEY、MYSQL_PASSWORD、MYSQL_ROOT_PASSWORD、NEO4J_PASSWORD 请使用独立随机值。
# DEEPSEEK_API_KEY 留空时非 AI 接口可工作，AI 接口会明确失败。
